// currena-wgc-watch — the WGC monthly commentary watch worker.
//
// A minimal, dependency-free Cloudflare Worker (spec §4.1): the scheduled
// fetch → slug guard → parse → gates → upsert pipeline over the SAME D1
// database as the desk (aurum-desk), plus a read-only health endpoint on
// its workers.dev URL. It binds the same database_id and claims no route
// on currena.ir — the zone stays exactly as it is.
//
// The cron triggers (spec §4.2): daily 09:30 UTC on days 1–15 of every
// month, plus grace days 17/19/21/23/25 — at most 20 fires per window,
// zero requests for June/November targets (the series skips both).
//
// Deploy (from this directory, credentials env-only):
//   CLOUDFLARE_API_TOKEN=… CLOUDFLARE_ACCOUNT_ID=… bunx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currena-wgc-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["30 9 1-15 * *", "30 9 17-25/2 * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurum-desk",
      // The desk's own database (wrangler d1 create aurum-desk, 2026-11-22) —
      // shared, never re-seeded.
      "database_id": "264617a4-5bfa-43af-8c9c-d4c95d257dc8"
    }
  ],
  "observability": {
    "enabled": true
  }
}
