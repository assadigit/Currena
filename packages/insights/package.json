{
  "name": "@currena/insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Insights feature: indicator definitions, scoring engine, fixture parsers and (via ./adapters) the Phase I2 source adapters. Root export stays pure/platform-free for the SPA; ./adapters carries the fetch halves (web-standard fetch only) for the runner.",
  "exports": {
    ".": "./src/index.ts",
    "./validation": "./src/validation.ts",
    "./adapters": "./src/adapters/index.ts",
    "./store": "./src/store.ts",
    "./markets": "./src/markets/index.ts",
    "./markets/definitions": "./src/markets/definitions.ts",
    "./fx": "./src/fx/index.ts",
    "./fx/definitions": "./src/fx/definitions.ts",
    "./prices": "./src/prices/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "backtest": "tsx scripts/backtest.ts",
    "live-run": "tsx scripts/live-run.ts",
    "ingest": "tsx scripts/ingest.ts",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "markets-data-check": "tsx scripts/markets-data-check.ts",
    "markets-run": "tsx scripts/markets-run.ts",
    "fx-run": "tsx scripts/fx-run.ts",
    "markets-backtest": "tsx scripts/markets-backtest.ts",
    "prices-run": "tsx scripts/prices-run.ts",
    "fx-data-check": "tsx scripts/fx-data-check.ts",
    "fx-evidence": "tsx scripts/fx-evidence.ts",
    "safety-demo": "tsx scripts/safety-demo.ts",
    "regression:generate": "tsx scripts/generate-regression-episodes.ts"
  },
  "dependencies": {
    "@currena/core": "workspace:*",
    "@currena/scraper": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
