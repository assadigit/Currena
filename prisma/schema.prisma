/**
 * `driverAdapters` (preview) is the Cloudflare Workers deployment seam: on a
 * Worker the SQLite file engine cannot run, so the client is instead given a
 * D1 driver adapter (see src/lib/db.ts). The sandbox dev server keeps the
 * default engine path unchanged — the feature only *adds* the adapter
 * option, and Prisma requires the normally-generated client (with engine)
 * for the adapter path to be valid at all.
 */
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * One row per desk date. The S8 briefing payload and the S9 visuals
 * payload are stored as serialised JSON text (SQLite has no list/array
 * primitives, and the payloads are read as whole documents anyway).
 *
 * S10 adds provenance columns: `dataMode` records how the market series
 * were served ("live" | "mixed" | "modelled") and `provenanceJson` holds
 * the per-dataset live-vs-modelled record. Rows written before S10 have
 * dataMode "modelled" and a null provenanceJson — they are treated as
 * cache misses and rebuilt grounded.
 */
model DeskDay {
  id              String   @id @default(cuid())
  date            String   @unique
  briefingJson    String
  visualsJson     String
  narrativeSource String   @default("template")
  dataMode        String   @default("modelled")
  provenanceJson  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * S10 Roots layer — one observation row per dataset per trading day
 * (no list-typed primitives: each symbol-date is its own row).
 */
model Observation {
  id        String   @id @default(cuid())
  dataset   String // gold | dxy | spx | realYield | silver | oil | dxy:<pair>
  date      String // YYYY-MM-DD trading day
  close     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dataset, date])
  @@index([dataset])
}

/**
 * S10 Roots layer — the EODHD source registry state: which dataset is
 * served by which symbol, whether the last sync succeeded, and the
 * latest observation date seen. One row per logical dataset.
 */
model SourceSync {
  id        String   @id @default(cuid())
  dataset   String   @unique
  symbol    String // the EODHD symbol (or formula description) that served it
  status    String   @default("live") // live | unavailable | error
  asOf      String? // latest observation date in the store
  syncedAt  DateTime @updatedAt
  note      String?
}

/**
 * S13 Watch layer — one owner-defined watch rule. Rules are evaluated
 * server-side at read time over what the desk already persists (the
 * DeskDay cache, the Observation store and the S12 calibration record);
 * nothing here adds a second polling or network surface.
 *
 * `kind` selects the engine's rule family:
 *   price-level   — gold's latest observed close crossing `level`
 *                   (direction: above | below | cross)
 *   bias-flip     — the published stance changing sign, or crossing
 *                   `level` (direction: sign | above | below)
 *   scenario-band — the latest base-case target, or its implied move,
 *                   crossing `level` (basis: target | implied-move)
 *   calibration   — a rolling scorecard threshold: `metric` selects
 *                   base-miss | direction-hit-rate, `direction` selects
 *                   above | below
 *
 * Scalar columns only (SQLite has no list primitives); `direction` and
 * the metric selectors carry the family-specific semantics so one row
 * fully describes one rule.
 */
model WatchRule {
  id        String   @id @default(cuid())
  kind      String // price-level | bias-flip | scenario-band | calibration
  label     String // owner-facing name shown in the watch band
  level     Float // the threshold the rule watches (USD, bias points, or percent)
  direction String // above | below | cross | sign | target | implied-move (per kind)
  metric    String   @default("base-miss") // calibration rules only: base-miss | direction-hit-rate
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/**
 * The WGC monthly commentary Highlights — one row per REVIEWED month
 * ("YYYY-MM"; the issue that reviews month M publishes early in M+1;
 * June and November have no issue). Written by the currena-wgc-watch
 * Worker's scheduled fire and the one-off backfill
 * (docs/wgc-monthly-commentary-spec.md §4.6); strictly a READ model for
 * the desk — this app never writes it. Columns map 1:1 to the D1 DDL
 * (wgc-watch/ddl.sql); no DateTime fields, so the D1 bind shim is
 * never involved. `status` is ok | missed | structure_alert — the
 * waiting state is the absence of a row (the route derives it from the
 * scrape log's attempt count while the window is open). The ISO-TEXT
 * timestamp columns (publishedAt/fetchedAt/lastAttemptAt/updatedAt and
 * the log's ts) ride the db.ts read-side shim on the Worker (the D1
 * adapter would otherwise infer DateTime from their values) — readers
 * restore the verbatim bytes with unwrapD1Text.
 */
model WgcCommentary {
  monthKey      String  @id @map("month_key")
  sourceUrl     String  @map("source_url")
  headline      String? @map("headline")
  publishedAt   String? @map("published_at") // WGC's own JSON-LD datePublished, verbatim
  fetchedAt     String  @map("fetched_at") // ISO UTC — when the watch worker captured it
  highlightsJson String @map("highlights_json") // [{"heading":…,"body":…}] verbatim, in order
  blockVariant  String  @map("block_variant")
  contentHash   String  @map("content_hash")
  status        String  @default("ok") @map("status") // ok | missed | structure_alert
  attempts      Int     @default(0) @map("attempts")
  lastAttemptAt String? @map("last_attempt_at")
  updatedAt     String? @map("updated_at") // set only when a re-store followed a WGC edit

  @@map("wgc_commentary")
}

/**
 * The Persian translation side table (wgc-watch/ddl.sql, the 2026-11-25
 * sitting — spec §8's deferred phase). One row per REVIEWED month, written
 * by the watch worker's translation step once per monthly issue (keyed to
 * the ENGLISH row's content_hash: the stored Farsi serves forever until
 * the English content actually changes); strictly a READ model for the
 * desk — this app never writes it. Columns map 1:1 to the D1. The ISO-TEXT
 * translatedAt rides the db.ts read-side shim on the Worker (same rule as
 * the parent table's timestamps); faJson (a JSON payload) passes the shim
 * untouched, like highlightsJson. sourceModel is the engine identity —
 * the route surfaces it so a translation can never be misattributed.
 */
model WgcCommentaryFa {
  monthKey     String  @id @map("month_key")
  faHeadline   String? @map("fa_headline") // the headline's Persian translation; NULL when the English headline is NULL
  faJson       String  @map("fa_json") // [{"heading":…,"body":…}] Persian, the English order and shape
  sourceModel  String  @map("source_model") // e.g. '@cf/meta/m2m100-1.2b' — the bake-off record's selected model
  translatedAt String @map("translated_at") // ISO UTC — rides the read-side shim
  contentHash  String  @map("content_hash") // the ENGLISH row's hash at translation time — the freshness key

  @@map("wgc_commentary_fa")
}

/**
 * The watch worker's scrape log — the per-fire record the health
 * endpoint reads and this app reads only for the honest attempt count
 * of a waiting month (every fetch-404 / fetch-redirect-rejected /
 * fetch-error line is one real attempt). Read-only for the desk.
 */
model WgcScrapeLog {
  ts       String @map("ts") // ISO UTC
  monthKey String @map("month_key")
  event    String @map("event") // fetch-404 | fetch-redirect-rejected | fetch-error | stored | re-stored | structure-alert | missed | skip-month | translated | translate-failed
  detail   String?

  @@id([ts, monthKey]) // Prisma identity only — the DDL table carries no key of its own
  @@index([monthKey])
  @@map("wgc_scrape_log")
}
