# ============================================================
# Currena — .gitignore (committed FIRST by design: Phase 0)
# Safety: secrets and the legacy Django backup must never
# enter git history. Keep this file conservative.
# ============================================================

# --- credentials & secrets (NEVER commit) ---
credentials.md
credentials*.md
.dev.vars
.dev.vars.*
.env
.env.*
*.pem
*.key
service-account*.json

# --- legacy Django backup (reference only, big, not source) ---
/legacy/
/legacy-captures/

# --- dependencies & build output ---
node_modules/
dist/
build/
.output/
*.tsbuildinfo
.rollup.cache/

# --- cloudflare / wrangler ---
.wrangler/
.dev.vars*
wrangler.dev.toml

# --- testing ---
coverage/
.vitest-cache/

# --- editors & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- logs ---
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# --- misc scratch ---
tmp/
.cache/
.turbo/

# --- world markets provider cache (manual data-check / seed runs) ---
# Raw EODHD/Yahoo answers saved by scripts/markets-data-check.ts so re-runs
# never re-spend the 20-calls/day EODHD free quota. Never committed: they
# are provider data refreshes, not fixtures.
packages/insights/fixtures/markets-live/

# --- local preview data (2026-10-29) ---
# Output of pnpm --filter @currena/insights local-export: live-scraped
# JSON served by the sandbox Next.js preview host's currena-data service.
# Regenerable provider data, never committed (same rule as markets-live).
data/local-preview/
