exports[`the flipped view byte-stability pin (GB-S6) > the flipped view is pinned byte-for-byte (the snapshot — any change to the default view must be conscious) 1`] = `"<header class="flex flex-wrap items-center gap-2"><h3 class="type-question m-0 text-[var(--color-text-primary)]">Conditions for gold</h3><span class="ms-auto inline-flex items-center gap-1 text-[length:var(--type-caption)] font-semibold text-[var(--color-text-secondary)]" data-signal-metal="gold"><img alt="" aria-hidden="true" draggable="false" decoding="async" class="currena-icon shrink-0 select-none " style="--icon-size: 18px; --icon-size-sm: 22px;" src="/assets/icons/gold.png"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 11.5l4-4 2.5 2.5 4.5-5"></path></svg>Gold: Leaning for gold, 1 for · 0 against · 3 not leaning · 1 unread</span></header><div class="flex flex-col gap-2 rounded-[var(--radius-lg)] bg-[var(--color-surface)] p-3.5 ring-1 ring-[var(--color-border)] shadow-[var(--shadow-card)] sm:p-4" data-signal-verdict="true"><h4 class="m-0 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-[length:var(--type-label)] font-bold text-[var(--color-text-secondary)]" data-verdict-title="true">Conditions outlook<span class="font-normal text-[var(--color-text-tertiary)]">this describes current conditions, not a forecast</span></h4><div data-verdict-metal="gold" data-verdict-direction="bullish" class="flex min-w-0 flex-col gap-2 rounded-[var(--radius-md)] bg-[var(--color-surface)] p-3 ring-1 ring-[var(--color-border)]"><div class="flex items-center gap-3"><span aria-hidden="true" class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-[var(--radius-md)] ring-1 ring-[var(--color-border)] bg-[var(--color-accent-gold)]/25 sm:h-16 sm:w-16"><img alt="" aria-hidden="true" draggable="false" decoding="async" class="currena-icon shrink-0 select-none " style="--icon-size: 40px; --icon-size-sm: 48px;" src="/assets/icons/gold.png"></span><span class="min-w-0 flex-1 text-xl font-bold leading-snug text-[var(--color-text-primary)]">Gold</span><bdi class="shrink-0 whitespace-nowrap text-[length:var(--type-label)] font-semibold tabular-nums text-[var(--color-text-secondary)]">US$3,876</bdi></div><span class="inline-flex min-h-[2.5em] items-center gap-1.5 text-[var(--color-status-normal)]"><img alt="" aria-hidden="true" draggable="false" decoding="async" class="currena-icon shrink-0 select-none " style="--icon-size: 28px; --icon-size-sm: 36px;" src="/assets/icons/up-support-growth-increase.png"><span class="text-[length:var(--type-label)] font-bold leading-tight">Conditions lean in gold’s favour.</span></span><div data-verdict-chart="gold" class="flex min-w-0 flex-1 flex-col justify-center gap-1.5"><p role="status" class="m-0 text-[length:var(--type-caption)] text-[var(--color-text-tertiary)]" data-gold-price-chart="loading">Loading chart…</p></div></div></div><p data-balance-measured-note="true" class="bal-foot">Measured against gold’s actual moves over 2016 to 2026: the lean of these drivers showed no positive association with the next 5 to 60 days. If anything, readings against gold came before larger rises. It describes conditions, not direction. <a href="https://github.com/assadigit/Currena/blob/main/docs/insights/BACKTEST-GOLD-LANES.md" target="_blank" rel="noopener noreferrer" class="insights-focusable">Read the full backtest</a></p><nav aria-label="The five forces on this page" data-lane-drill="true" class="flex flex-wrap gap-x-3 gap-y-1"><a href="#lane-borrowing-costs" class="insights-focusable rounded py-1 text-[length:var(--type-caption)] font-semibold text-currena-blue underline-offset-2 hover:underline" data-lane-drill-link="borrowing-costs">Interest rates &amp; borrowing costs ↗</a><a href="#lane-dollar" class="insights-focusable rounded py-1 text-[length:var(--type-caption)] font-semibold text-currena-blue underline-offset-2 hover:underline" data-lane-drill-link="dollar">The US dollar ↗</a><a href="#lane-stress" class="insights-focusable rounded py-1 text-[length:var(--type-caption)] font-semibold text-currena-blue underline-offset-2 hover:underline" data-lane-drill-link="stress">Market stress &amp; uncertainty ↗</a><a href="#lane-inflation" class="insights-focusable rounded py-1 text-[length:var(--type-caption)] font-semibold text-currena-blue underline-offset-2 hover:underline" data-lane-drill-link="inflation">Inflation &amp; inflation expectations ↗</a><a href="#lane-flows" class="insights-focusable rounded py-1 text-[length:var(--type-caption)] font-semibold text-currena-blue underline-offset-2 hover:underline" data-lane-drill-link="flows">Trader positioning &amp; flows ↗</a></nav><div class="flex flex-col gap-2 border-t border-[var(--color-border)] pt-3"><h4 class="m-0 text-[length:var(--type-label)] font-bold text-[var(--color-text-tertiary)]">Price footing</h4><ul class="m-0 flex list-none flex-col gap-1.5 p-0"><li class="flex flex-col gap-0.5 rounded-[var(--radius-sm)] bg-[var(--color-surface)] px-2.5 py-2 ring-1 ring-[var(--color-border)]" data-footing-metal="gold" data-footing-state="against"><span class="flex flex-wrap items-baseline gap-x-2"><span class="inline-flex shrink-0 items-center gap-1.5"><img alt="" aria-hidden="true" draggable="false" decoding="async" class="currena-icon shrink-0 select-none " style="--icon-size: 24px; --icon-size-sm: 30px;" src="/assets/icons/gold.png"><span class="inline-flex shrink-0 items-center gap-1 text-[var(--color-status-alert)]"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 6.5l4 4 2.5-2.5 4.5 5"></path></svg><span class="text-[length:var(--type-label)] font-bold">Works against</span></span></span><span class="text-[length:var(--type-label)] font-bold text-[var(--color-text-primary)]">Gold</span><bdi dir="ltr" class="text-[length:var(--type-caption)] font-semibold tabular-nums text-[var(--color-text-secondary)]">US$3,876</bdi><span class="text-[length:var(--type-caption)] text-[var(--color-text-secondary)]">high of the last 10 years</span><span class="ms-auto flex items-baseline gap-1 text-[length:var(--type-caption)] text-[var(--color-text-secondary)]">30-day speed:<bdi dir="ltr" class="font-semibold tabular-nums">−7.76%</bdi></span></span><span class="text-[length:var(--type-label)] leading-relaxed text-[var(--color-text-secondary)]">A price holding or rising in its 10-year range is firm footing; a falling one is not.</span></li></ul></div>"`;
