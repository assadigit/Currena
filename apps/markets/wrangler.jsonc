{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currena-markets",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // [currena-markets cron consolidation, 2026-11-24] The world stock
  // markets section's four original cron triggers (insights-world-markets-
  // spec.md §3.4) were consolidated into this ONE covering expression to
  // free the account's cron quota for currena-wgc-watch (the Workers Free
  // plan allows five triggers per account; currena-api's minute cron +
  // this one + the watch worker's two leave one spare). The scheduled
  // handler dispatches by the fire's own scheduled UTC time — equivalent
  // to the original four-trigger dispatch at every original fire minute
  // (src/index.ts; the four windows stay documented in src/crons.ts and
  // pinned by the tests). The covering expression's extra wakes (01:00,
  // 01:50, 07:30, 08:00, 08:30, 23:00, 23:50 UTC) carry no job — one log
  // line and return. The four original expressions, for the record:
  //   main  30 23 * * 1-5 — all 16 markets have closed; EODHD first.
  //   retry 30 1 * * 2-6  — re-fetches failed/old markets; when the whole
  //                         snapshot is old (the main run's write bounced
  //                         off the saturated daily KV budget ~18:30 UTC),
  //                         it re-fetches through Yahoo and lands the
  //                         day's single write in the fresh post-midnight
  //                         budget slice.
  //   asia  50 8 * * 2-6  — F1 (2026-10-21 session-finality round): after
  //                         the Asian sessions close, the rung re-fetches
  //                         the held intraday rows and lands the day's
  //                         final closes (the 01:30 retry holds mid-
  //                         session points instead of freezing them).
  //   au    0 7 * * 1-5   — gap-closure S5-M5.4: the Australian markets
  //                         board (the 18 probe-verified ASX indices),
  //                         Yahoo-only, 30 min after the ASX 06:00 UTC
  //                         close + 30 min F1 margin. Runs ALONE (no fx
  //                         twin) in its own invocation.
  "triggers": {
    "crons": ["0,30,50 1,7,8,23 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATES",
      "id": "4627ac33a4b148ff9fc2189266b1890e"
    }
  ]
  // The EODHD free key lands via `wrangler secret put EODHD_API_TOKEN`
  // (never in this file); local dev reads `apps/markets/.dev.vars`
  // (gitignored). Without the secret the worker still runs: every EODHD
  // call fails fast and Yahoo serves the data (the designed fallback).
}
