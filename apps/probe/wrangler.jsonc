{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TEMPORARY Gate-2 diagnostic worker — deleted after the Path A/B decision.
  // It answers exactly one question with hard evidence:
  //   "can a deployed Cloudflare Worker egress to TGJU?"
  // No secrets, no bindings, no storage. Account comes from CLOUDFLARE_ACCOUNT_ID.
  "name": "currena-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  }
}
