{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currena-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATES",
      "id": "4627ac33a4b148ff9fc2189266b1890e"
    }
  ]
  // Phase 5 wires the SPA into this same Worker (one deploy, no CORS):
  //   "assets": { "directory": "../web/dist", "not_found_handling": "single-page-application" }
  // Secrets land via `wrangler secret put REFRESH_SECRET` (never in this file);
  // local dev reads `apps/api/.dev.vars` (gitignored).
}
