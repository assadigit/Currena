{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "currena-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Ever-green rates (2026-09-18): the ladder used to be pull-only — with zero
  // visitors the KV snapshot aged until the first request scraped again, and a
  // failing scrape served the stale-cache rung ("last updated 3 hours ago").
  // A minute cron now keep-warms both sources through the SAME ladder (the
  // FRESH_TTL_SEC=300 fresh-cache guard + MIN_SCRAPE_INTERVAL_SEC=60 cap the
  // actual scrape cadence at ~1 request / 5 min ≈ 288/day per source — polite,
  // free-tier safe). tgju runs every minute; frankfurter (ECB data, updates
  // ~daily) every 15th minute only.
  //
  // 2026-10-12 — the :13 minute of every hour additionally refreshes the
  // Insights live prices (Yahoo quotes for the Prices board, write-only-
  // if-changed to insights:prices-live:v1; see src/index.ts PRICES_CRON_MINUTE).
  // No new cron trigger: the account's free 5-cron limit is full.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATES",
      "id": "4627ac33a4b148ff9fc2189266b1890e"
    }
  ],
  // One deploy, no CORS: the same Worker serves the built SPA (Phase 5).
  // Step 3 §2.2 (runbook Phase 3): SITE_MODE is 'private' by default — every
  // /api/insights* route sits behind the INSIGHTS_PASSWORD gate (a wrangler
  // SECRET, set with `wrangler secret put INSIGHTS_PASSWORD`, never here).
  // 2026-10-19 OWNER DECREE: the Insights page is PUBLIC. SITE_MODE='public'
  // skips the gate (AC-08) and the T-15 build gate verifies the generated
  // data/site-mode-overrides.json hides every source that is not public-
  // display-ok (24 indicators + the EODHD/Yahoo-backed world boards; LR-02).
  // The public serve path reads ONLY the projection keys
  // (insights:snapshot-public, written by the daily ingest + the
  // public-projection bootstrap) — the private document never leaks.
  // Flipping back to 'private' re-arms the password gate (the
  // INSIGHTS_PASSWORD secret stays set on the Worker).
  "vars": {
    "SITE_MODE": "public",
    // ---- The Layer-2 narrator (M4, spec §9) ----
    // The kill switch: 'false' = template narratives only (no model calls
    // at all — also the behaviour whenever GEMINI_API_KEY is unset).
    // The staged rollout (D-34): 'false' = generated + stored, shown only
    // at ?narrative=preview until the owner flips it (one command, see
    // docs/DEPLOY.md "The Gemini key").
    // Part 3 (news) ships DISABLED (D-29: the grounding terms' display
    // requirements are not implemented; the flag exists so a later
    // session can enable it after reading the current ToS in full).
    // GEMINI_API_KEY is a SECRET — set with `pnpm narrator:set-key`,
    // NEVER a var here (spec §10).
    "NARRATOR_ENABLED": "false",
    "NARRATOR_VISIBLE": "false",
    "NARRATOR_WEB_CONTEXT": "false",
    "NARRATOR_WEB_DAILY_CAP": "20",
    "NARRATOR_MODEL": "gemini-3.5-flash-lite",
    // D-41 — the model provider. Default 'gemini' (the M3 REST client + the
    // GEMINI_API_KEY secret). Flip to 'cloudflare' to use the Workers AI
    // binding below (no token, no secret, no region risk — auth is implicit).
    // The cloudflare path clamps NARRATOR_WEB_CONTEXT to false (workers-ai
    // has no google-search grounding → Part 3 stays disabled).
    "NARRATOR_PROVIDER": "gemini"
  },
  // D-41 — the Workers AI binding (active only when NARRATOR_PROVIDER=cloudflare).
  // Authenticates IMPLICITLY via the Cloudflare account; NO API token is stored
  // anywhere (the binding is the auth). Default model:
  // @cf/meta/llama-3.3-70b-instruct-fp8-fast (D-41 §3 — re-verified live:
  // clean native Farsi, 0% Latin, correct half-spaces, ~4s, ~50 neurons/call).
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Phase 6: navigation-style requests (Sec-Fetch-Dest: document) to
    // non-asset paths are served index.html by the platform WITHOUT running
    // the Worker — verified live on 2026-09-17. /admin must render from the
    // Worker, and /api|/internal must answer JSON regardless of how they are
    // called, so these paths are pinned Worker-first.
    "run_worker_first": ["/admin", "/admin/*", "/api", "/api/*", "/internal", "/internal/*"]
  }
  // Secrets land via `wrangler secret put REFRESH_SECRET` (never in this file);
  // local dev reads `apps/api/.dev.vars` (gitignored).
}
