{
  "name": "currena",
  "private": true,
  "version": "0.1.0",
  "description": "Currena \u2014 currency converter with live Iranian Toman (open-market) and international rates. Hono API on Cloudflare Workers + Vite React SPA (PWA).",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "deploy": "pnpm --filter @currena/api run deploy",
    "copy:audit": "node scripts/audit-persian-copy.mjs",
    "copy:audit:update": "node scripts/update-persian-copy-manifest.mjs",
    "lint": "eslint .",
    "registry:generate": "tsx scripts/generate-indicators-registry.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "dompurify": ">=3.4.16",
      "source-map-js": ">=1.2.2",
      "serialize-javascript": ">=7.1.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}